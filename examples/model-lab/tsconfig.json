{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["app", ".forge/types"],
  "exclude": ["app/_model/rust-renderer.ts", "app/_model/rust-view.ts", "app/_model/mixed-view.ts"]
}
